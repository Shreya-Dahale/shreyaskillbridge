generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  EMPLOYER
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime          @default(now())
  candidate    CandidateProfile?
  employer     EmployerProfile?
}

model CandidateProfile {
  id            String           @id @default(cuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline      String?
  createdAt     DateTime         @default(now())
  careerHistory CareerHistory[]
  careerBreaks  CareerBreak[]
  skills        CandidateSkill[]
  resumes       Resume[]
  targets       TargetJob[]
  submissions   Submission[]
  evidence      Evidence[]
  shareLinks    ShareLink[]
}

model EmployerProfile {
  id          String      @id @default(cuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?
  about       String?
  createdAt   DateTime    @default(now())
  jobs        Job[]
  shareViews  ShareView[]
}

enum SkillSource {
  EXTRACTED
  USER_ADDED
  USER_EDITED
}

model CareerHistory {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobTitle    String
  company     String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime         @default(now())

  @@index([candidateId])
}

model CareerBreak {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime         @default(now())

  @@index([candidateId])
}

model Skill {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]
  aliases         SkillAlias[]
  relationsFrom   SkillRelation[]  @relation("RelationFrom")
  relationsTo     SkillRelation[]  @relation("RelationTo")
  taskSkills      TaskSkill[]
  evidence        Evidence[]
}

model CandidateSkill {
  id              String           @id @default(cuid())
  candidateId     String
  candidate       CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill            @relation(fields: [skillId], references: [id])
  yearsExperience Float?
  lastUsedYear    Int?
  source          SkillSource
  createdAt       DateTime         @default(now())

  @@unique([candidateId, skillId])
  @@index([candidateId])
}

model Resume {
  id             String           @id @default(cuid())
  candidateId    String
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName       String
  storagePath    String
  sizeBytes      Int
  extractedText  String?
  extractionJson Json?
  extractedAt    DateTime?
  uploadedAt     DateTime         @default(now())

  @@index([candidateId])
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SkillImportance {
  REQUIRED
  PREFERRED
}

model Job {
  id             String          @id @default(cuid())
  employerId     String
  employer       EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title          String
  description    String
  status         JobStatus       @default(DRAFT)
  extractionJson Json?
  extractedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  skills         JobSkill[]
  targets        TargetJob[]

  @@index([employerId])
}

model JobSkill {
  id         String          @id @default(cuid())
  jobId      String
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill           @relation(fields: [skillId], references: [id])
  importance SkillImportance
  minYears   Float?

  @@unique([jobId, skillId])
  @@index([jobId])
}

enum SkillRelationKind {
  IMPLIES
  RELATED
}

model SkillAlias {
  id      String @id @default(cuid())
  alias   String @unique
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model SkillRelation {
  id     String            @id @default(cuid())
  fromId String
  from   Skill             @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Skill             @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)
  kind   SkillRelationKind

  @@unique([fromId, toId])
  @@index([toId])
}

model TargetJob {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([candidateId, jobId])
  @@index([jobId])
}

enum TaskKind {
  JAVA_CODE
  SQL
  PROJECT
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
}

enum EvidenceKind {
  PASSED
  IN_PROGRESS
}

model Task {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  kind         TaskKind
  instructions String
  starterCode  String         @default("")
  timeLimitMs  Int            @default(3000)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  skills       TaskSkill[]
  testCases    TaskTestCase[]
  submissions  Submission[]
  evidence     Evidence[]
}

model TaskSkill {
  id      String @id @default(cuid())
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@unique([taskId, skillId])
  @@index([skillId])
}

model TaskTestCase {
  id             String  @id @default(cuid())
  taskId         String
  task           Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label          String
  input          String  @default("")
  expectedOutput String
  hidden         Boolean @default(true)
  position       Int

  @@index([taskId])
}

model Submission {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  code        String
  status      SubmissionStatus @default(QUEUED)
  passedCount Int              @default(0)
  totalCount  Int              @default(0)
  resultJson  Json?
  createdAt   DateTime         @default(now())
  gradedAt    DateTime?

  @@index([candidateId, taskId])
}

model Evidence {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill            @relation(fields: [skillId], references: [id])
  taskId      String?
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  kind        EvidenceKind
  occurredAt  DateTime

  @@unique([candidateId, skillId, taskId, kind])
  @@index([candidateId])
}

enum ShareAudience {
  EMPLOYERS
  ANYONE
}

model ShareLink {
  id                 String           @id @default(cuid())
  candidateId        String
  candidate          CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  label              String?
  tokenHash          String           @unique
  audience           ShareAudience    @default(EMPLOYERS)
  showName           Boolean          @default(false)
  includeHeadline    Boolean          @default(true)
  includeSkills      Boolean          @default(true)
  includeAssessments Boolean          @default(true)
  includeSummary     Boolean          @default(true)
  includeRoles       Boolean          @default(false)
  includeBreak       Boolean          @default(false)
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())
  views              ShareView[]

  @@index([candidateId])
}

model ShareView {
  id               String           @id @default(cuid())
  shareLinkId      String
  shareLink        ShareLink        @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  viewerEmployerId String?
  viewerEmployer   EmployerProfile? @relation(fields: [viewerEmployerId], references: [id], onDelete: SetNull)
  viewerCompany    String?
  viewedAt         DateTime         @default(now())

  @@index([shareLinkId, viewedAt])
}
