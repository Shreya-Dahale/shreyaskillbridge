generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  EMPLOYER
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime          @default(now())
  candidate    CandidateProfile?
  employer     EmployerProfile?
}

model CandidateProfile {
  id            String           @id @default(cuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline      String?
  createdAt     DateTime         @default(now())
  careerHistory CareerHistory[]
  careerBreaks  CareerBreak[]
  skills        CandidateSkill[]
  resumes       Resume[]
  targets       TargetJob[]
}

model EmployerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?
  about       String?
  createdAt   DateTime @default(now())
  jobs        Job[]
}

enum SkillSource {
  EXTRACTED
  USER_ADDED
  USER_EDITED
}

model CareerHistory {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobTitle    String
  company     String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime         @default(now())

  @@index([candidateId])
}

model CareerBreak {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime         @default(now())

  @@index([candidateId])
}

model Skill {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]
  aliases         SkillAlias[]
  relationsFrom   SkillRelation[]  @relation("RelationFrom")
  relationsTo     SkillRelation[]  @relation("RelationTo")
}

model CandidateSkill {
  id              String           @id @default(cuid())
  candidateId     String
  candidate       CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill            @relation(fields: [skillId], references: [id])
  yearsExperience Float?
  lastUsedYear    Int?
  source          SkillSource
  createdAt       DateTime         @default(now())

  @@unique([candidateId, skillId])
  @@index([candidateId])
}

model Resume {
  id             String           @id @default(cuid())
  candidateId    String
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName       String
  storagePath    String
  sizeBytes      Int
  extractedText  String?
  extractionJson Json?
  extractedAt    DateTime?
  uploadedAt     DateTime         @default(now())

  @@index([candidateId])
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SkillImportance {
  REQUIRED
  PREFERRED
}

model Job {
  id             String          @id @default(cuid())
  employerId     String
  employer       EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title          String
  description    String
  status         JobStatus       @default(DRAFT)
  extractionJson Json?
  extractedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  skills         JobSkill[]
  targets        TargetJob[]

  @@index([employerId])
}

model JobSkill {
  id         String          @id @default(cuid())
  jobId      String
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill           @relation(fields: [skillId], references: [id])
  importance SkillImportance
  minYears   Float?

  @@unique([jobId, skillId])
  @@index([jobId])
}

enum SkillRelationKind {
  IMPLIES
  RELATED
}

model SkillAlias {
  id      String @id @default(cuid())
  alias   String @unique
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model SkillRelation {
  id     String            @id @default(cuid())
  fromId String
  from   Skill             @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Skill             @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)
  kind   SkillRelationKind

  @@unique([fromId, toId])
  @@index([toId])
}

model TargetJob {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([candidateId, jobId])
  @@index([jobId])
}